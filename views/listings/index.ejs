<% layout("/layouts/boilerplate")%> 
      <div id="filters" class="mt-3">
        <% for (const filter of [
          ["fa-fire", "Trending"], ["fa-bed", "Rooms"], ["fa-mountain-city", "Iconic Cities"],
          ["fa-mountain", "Mountains"], ["fa-person-swimming", "Pools"], ["fa-campground", "Camping"],
          ["fa-cow", "Farms"], ["fa-snowflake", "Arctic"], ["fa-igloo", "Domes"], ["fa-ship", "Boats"]
        ]) { %>
          <div class="filter"><i class="fa-solid <%= filter[0] %>"></i><p><%= filter[1] %></p></div>
        <% } %>
        <div class="tax-toggle">
          <div class="form-check-reverse form-switch">
            <input class="form-check-input" type="checkbox" role="switch" id="flexSwitchCheckDefault">
            <label class="form-check-label" for="flexSwitchCheckDefault">Display total after taxes</label>
          </div>
        </div>
      </div>

      <h3><%= query ? `Search results for “${query}”` : "All Listings" %></h3>

      <!-- In your views/listings/index.ejs file -->
<div class="row row-cols-lg-4 row-cols-md-2 row-cols-1 g-4 mt-3">
  <% for(let listing of allListings) { %>
    
    <a href="/listings/<%= listing._id %>" class="listing-link">
      <div class="card col listing-card">
        <img src="<%= listing.imageUrl %>" class="card-img-top" alt="<%= listing.title %>">
        <!-- Ensure the img height and object-fit are handled in CSS below -->
        <div class="card-body">
          <p class="card-text">
            <b><%= listing.title %></b><br>
            &#8377; <%= listing.price.toLocaleString("en-IN") %> / night
            <i class="tax-info">&nbsp; +18% GST</i>
          </p>
        </div>
      </div>
    </a>
  <% } %>
</div>

<% if (allListings.length === 0) { %>
  <div class="empty-state"><h4>No destinations found</h4><p>Try another city, country, or listing name.</p></div>
<% } %>

<script>
  document.getElementById("flexSwitchCheckDefault")?.addEventListener("click", () => {
    document.querySelectorAll(".tax-info").forEach((item) => item.classList.toggle("show-tax"));
  });
</script>
